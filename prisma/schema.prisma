datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  name         String
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  accounts     Account[]
  trades       Trade[]
  strategies   Strategy[]
  journal      JournalEntry[]
  notes        Note[]

  @@index([email])
}

model Account {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  broker          String
  accountType     String   // PERSONAL, FUNDED, EVALUATION, DEMO
  startingBalance Float    // Fixed precision financial value
  currentBalance  Float    // Fixed precision financial value
  currency        String   @default("USD")
  status          String   @default("ACTIVE") // ACTIVE, ARCHIVED
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  trades          Trade[]

  @@index([userId])
}

model Trade {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol          String
  assetClass      String      // FOREX, FUTURES, STOCKS, CRYPTO, INDICES, COMMODITIES
  direction       String      // LONG, SHORT
  entryPrice      Float
  exitPrice       Float
  quantity        Float
  stopLoss        Float?
  takeProfit      Float?
  entryTime       DateTime
  exitTime        DateTime
  durationMinutes Int         @default(0)
  grossPnL        Float       @default(0)
  fees            Float       @default(0)
  netPnL          Float       @default(0)
  rMultiple       Float       @default(0)
  initialRisk     Float       @default(0)
  initialReward   Float       @default(0)
  riskRewardRatio Float       @default(0)
  isWin           Boolean     @default(false)
  isLoss          Boolean     @default(false)
  isBreakEven     Boolean     @default(false)
  strategyId      String?
  strategy        Strategy?   @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  setup           String?
  session         String?     // ASIA, LONDON, NEW_YORK, OVERLAP
  tags            String?     // JSON array string
  mistake         String?
  emotion         String?
  rating          Int?        @default(5)
  notes           String?
  status          String      @default("CLOSED") // OPEN, CLOSED
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  executions      Execution[]

  @@index([userId])
  @@index([accountId])
  @@index([symbol])
  @@index([entryTime])
}

model Execution {
  id        String   @id @default(uuid())
  tradeId   String
  trade     Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  action    String   // BUY, SELL
  quantity  Float
  price     Float
  fee       Float    @default(0)
}

model Strategy {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  market      String?
  timeframe   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trades      Trade[]

  @@index([userId])
}

model JournalEntry {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          String   // YYYY-MM-DD
  preMarketPlan String?
  duringSession String?
  eodReview     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Note {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  folder    String   @default("General")
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
