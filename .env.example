# MEGA JOURNAL — Environment Variables Template for Production

# Database Connection (Neon / Supabase PostgreSQL Connection Pooler)
DATABASE_URL="postgresql://postgres:password@ep-pooler.region.neon.tech/megajournal?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@ep-direct.region.neon.tech/megajournal?sslmode=require"

# Next.js App Base URL & Secret Secrets
NEXT_PUBLIC_APP_URL="https://mega-journal.vercel.app"
JWT_SECRET="generate-a-32-byte-hex-secret-string-here"
NEXTAUTH_SECRET="generate-a-32-byte-hex-secret-string-here"

# Vercel Blob Storage Credentials
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_sample"

# External AI Provider (Optional)
GEMINI_API_KEY="AIzaSy_sample_key"
